# Dependências (reinstaláveis via npm install / docker build)
node_modules/
**/node_modules/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Build do frontend
frontend/dist/
dist/

# Arquivos temporários de gravação atômica dos stores
**/*.json.tmp

# Variáveis de ambiente locais
.env
.env.*
!.env.example

# Metadados de sistema operacional
.DS_Store
**/.DS_Store
__MACOSX/

# Arquivos de editor/IDE
.vscode/
.idea/
*.swp

# Dados de runtime dos serviços (recriados automaticamente no start).
# As pastas data/ são mantidas no repositório via .gitkeep.
servico-produtos/data/*.json
servico-carrinho/data/*.json
servico-pedidos/data/*.json
